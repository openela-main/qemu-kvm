diff --git a/tests/unit/test-mshv-mmu.c b/tests/unit/test-mshv-mmu.c
new file mode 100644
index 0000000000..0966194e09
--- /dev/null
+++ b/tests/unit/test-mshv-mmu.c
@@ -0,0 +1,439 @@
+/*
+ * Copyright Microsoft, Corp. 2026
+ *
+ * Authors: Magnus Kulke  <magnuskulke@microsoft.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "mshv/mshv-mmu.h"
+
+static uint8_t ram[0x20000];
+static CPUX86State env;
+static hwaddr unreadable;
+
+static MemTxResult test_page_read(AddressSpace *as, hwaddr addr,
+                                  MemTxAttrs attrs, void *buf, hwaddr len)
+{
+    if (addr == unreadable || addr > sizeof(ram) ||
+        len > sizeof(ram) - addr) {
+        return MEMTX_ERROR;
+    }
+    memcpy(buf, ram + addr, len);
+    return MEMTX_OK;
+}
+
+static uint64_t test_page_readq(AddressSpace *as, hwaddr addr, MemTxAttrs attrs,
+                                MemTxResult *result_out)
+{
+    uint64_t value;
+    MemTxResult result;
+
+    result = test_page_read(as, addr, attrs, &value, sizeof(value));
+    *result_out = result;
+    return value;
+}
+
+static uint32_t test_page_readl(AddressSpace *as, hwaddr addr, MemTxAttrs attrs,
+                                MemTxResult *result_out)
+{
+    uint32_t value;
+    MemTxResult result;
+
+    result = test_page_read(as, addr, attrs, &value, sizeof(value));
+    *result_out = result;
+    return value;
+}
+
+#define address_space_ldl_le test_page_readl
+#define address_space_ldq_le test_page_readq
+#include "mshv/mshv-mmu.c"
+#undef address_space_ldq_le
+#undef address_space_ldl_le
+
+AddressSpace address_space_memory;
+
+static void reset(void)
+{
+    memset(&env, 0, sizeof(env));
+    memset(ram, 0, sizeof(ram));
+    unreadable = UINT64_MAX;
+    env.cr[0] = CR0_PE_MASK | CR0_PG_MASK | CR0_WP_MASK;
+    env.cr[3] = 0x1000;
+}
+
+static void entry64(uint64_t address, uint64_t value)
+{
+    stq_le_p(ram + address, value);
+}
+
+static void expect(uint64_t gva, bool write, bool execute,
+                   MshvTranslateResult result, uint64_t expected_gpa)
+{
+    uint64_t gpa = UINT64_MAX;
+
+    g_assert_cmpint(mshv_mmu_translate(&env, gva, &gpa, write, execute),
+                    ==, result);
+    if (result == MSHV_TRANSLATE_OK) {
+        g_assert_cmphex(gpa, ==, expected_gpa);
+    } else {
+        g_assert_cmphex(gpa, ==, UINT64_MAX);
+    }
+}
+
+static void map_long(uint64_t gva, unsigned int levels, uint64_t leaf)
+{
+    uint64_t table = 0x1000;
+    unsigned int level;
+
+    reset();
+    env.cr[4] = CR4_PAE_MASK | (levels == 5 ? CR4_LA57_MASK : 0);
+    env.efer = MSR_EFER_LME | MSR_EFER_LMA | MSR_EFER_NXE;
+    for (level = levels; level; level--) {
+        unsigned int index = (gva >> (12 + 9 * (level - 1))) & 511;
+
+        entry64(table + index * 8, level == 1 ? leaf : (table + 0x1000) | 7);
+        table += 0x1000;
+    }
+}
+
+/* Exercise non-paged, legacy, PAE, and four- and five-level paging. */
+static void test_modes(void)
+{
+    /* Paging disabled maps the virtual address directly. */
+    reset();
+    env.cr[0] = 0;
+    expect(0x12345, false, false, MSHV_TRANSLATE_OK, 0x12345);
+
+    /* Legacy two-level paging resolves a writable 4 KiB page. */
+    reset();
+    stl_le_p(ram + 0x1000, 0x2007);
+    stl_le_p(ram + 0x2000, 0xa007);
+    expect(0x123, true, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* Legacy PSE resolves a writable 4 MiB page. */
+    env.cr[4] = CR4_PSE_MASK;
+    stl_le_p(ram + 0x1000, 0x800087);
+    expect(0x12345, true, false, MSHV_TRANSLATE_OK, 0x812345);
+
+    /* A PDE PS bit is ignored when PSE is disabled. */
+    env.cr[4] = 0;
+    stl_le_p(ram + 0x1000, 0x2087);
+    expect(0x123, false, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* The resulting 4 KiB page remains writable. */
+    expect(0x123, true, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* A read-only 4 KiB page rejects writes with CR0.WP set. */
+    stl_le_p(ram + 0x2000, 0xa005);
+    expect(0x123, true, false, MSHV_TRANSLATE_PROTECTION, 0);
+
+    /* Legacy PAE selects the correct one of four PDPTEs. */
+    reset();
+    env.cr[4] = CR4_PAE_MASK;
+    env.cr[3] = 0x1020;
+    entry64(0x1020 + 3 * 8, 0x2001);
+    entry64(0x2000, 0x3007);
+    entry64(0x3000, 0xa007);
+    expect(0xc0000123, true, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* Four-level paging translates a canonical high-half address. */
+    map_long(0xffffffff8ea5847cULL, 4, 0xa007);
+    expect(0xffffffff8ea5847cULL, true, false, MSHV_TRANSLATE_OK, 0xa47c);
+
+    /* Five-level paging translates a 57-bit canonical address. */
+    map_long(0xff63dd288043150cULL, 5, 0xa007);
+    expect(0xff63dd288043150cULL, true, false, MSHV_TRANSLATE_OK, 0xa50c);
+
+    /* The same address is non-canonical under four-level paging. */
+    env.cr[4] &= ~CR4_LA57_MASK;
+    expect(0xff63dd288043150cULL, false, false, MSHV_TRANSLATE_INVALID, 0);
+}
+
+/* Exercise legacy PSE/PSE-36, legacy PAE, and long-mode large pages. */
+static void test_large_pages(void)
+{
+    /* A PDE large-page entry resolves a 2 MiB mapping. */
+    map_long(0x12345, 4, 0xa007);
+    entry64(0x3000, 0x200087);
+    expect(0x12345, false, false, MSHV_TRANSLATE_OK, 0x212345);
+
+    /* A PDPTE large-page entry resolves a 1 GiB mapping. */
+    entry64(0x2000, 0x40000087);
+    expect(0x12345, false, false, MSHV_TRANSLATE_OK, 0x40012345);
+
+    /* Misaligned address bits invalidate a 1 GiB mapping. */
+    entry64(0x2000, 0x40002087);
+    expect(0x12345, false, false, MSHV_TRANSLATE_INVALID, 0);
+
+    /* The large-page PAT bit is not treated as an address bit. */
+    entry64(0x2000, 0x40001087);
+    expect(0x12345, false, false, MSHV_TRANSLATE_OK, 0x40012345);
+
+    /* A PML4 entry cannot terminate the walk as a large page. */
+    entry64(0x1000, 0x2087);
+    expect(0x12345, false, false, MSHV_TRANSLATE_INVALID, 0);
+
+    /* Legacy PAE resolves a 2 MiB mapping. */
+    reset();
+    env.cr[4] = CR4_PAE_MASK;
+    entry64(0x1000, 0x2001);
+    entry64(0x2000, 0x400087);
+    expect(0x12345, false, false, MSHV_TRANSLATE_OK, 0x412345);
+
+    /* legacy PAE resolves a 4 MiB mapping */
+    reset();
+    env.cr[4] = CR4_PSE_MASK;
+    stl_le_p(ram + 0x1000, 0x800087);
+    expect(0x12345, false, false, MSHV_TRANSLATE_OK, 0x812345);
+}
+
+/* Exercise page permissions and architectural protection features. */
+static void test_permissions(void)
+{
+    /* Supervisor reads are allowed from a read-only page. */
+    map_long(0x123, 4, 0xa005);
+    expect(0x123, false, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* CR0.WP makes supervisor writes honor read-only mappings. */
+    expect(0x123, true, false, MSHV_TRANSLATE_PROTECTION, 0);
+
+    /* Clearing CR0.WP permits supervisor writes to read-only pages. */
+    env.cr[0] &= ~CR0_WP_MASK;
+    expect(0x123, true, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* User writes still honor read-only mappings without CR0.WP. */
+    env.segs[R_CS].selector = 3;
+    expect(0x123, true, false, MSHV_TRANSLATE_PROTECTION, 0);
+
+    /* A supervisor-only intermediate entry blocks user access. */
+    map_long(0x123, 4, 0xa007);
+    env.segs[R_CS].selector = 3;
+    entry64(0x1000, 0x2003);
+    expect(0x123, false, false, MSHV_TRANSLATE_PROTECTION, 0);
+
+    /* A read-only intermediate entry blocks supervisor writes. */
+    env.segs[R_CS].selector = 0;
+    entry64(0x1000, 0x2005);
+    expect(0x123, true, false, MSHV_TRANSLATE_PROTECTION, 0);
+
+    /* NX pages remain readable as data. */
+    map_long(0x123, 4, 0xa007 | PG_NX_MASK);
+    expect(0x123, false, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* NX pages reject instruction fetches. */
+    expect(0x123, false, true, MSHV_TRANSLATE_PROTECTION, 0);
+
+    /* An NX bit is reserved when EFER.NXE is disabled. */
+    env.efer &= ~MSR_EFER_NXE;
+    expect(0x123, false, false, MSHV_TRANSLATE_INVALID, 0);
+
+    /* SMEP blocks supervisor execution from a user page. */
+    map_long(0x123, 4, 0xa007);
+    env.cr[4] |= CR4_SMEP_MASK | CR4_SMAP_MASK;
+    expect(0x123, false, true, MSHV_TRANSLATE_PROTECTION, 0);
+
+    /* SMAP blocks supervisor data access to a user page. */
+    expect(0x123, false, false, MSHV_TRANSLATE_PROTECTION, 0);
+
+    /* EFLAGS.AC bypasses SMAP for supervisor data access. */
+    env.eflags |= AC_MASK;
+    expect(0x123, false, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* User-page data access with PKE requires unavailable PKRU state. */
+    map_long(0x123, 4, 0xa007);
+    env.cr[4] |= CR4_PKE_MASK;
+    expect(0x123, false, false, MSHV_TRANSLATE_UNSUPPORTED, 0);
+
+    /* Intermediate NX bits do not block data access. */
+    map_long(0x123, 4, 0xa007);
+    entry64(0x1000, 0x2007 | PG_NX_MASK);
+    expect(0x123, false, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* Intermediate NX bits block instruction fetches. */
+    expect(0x123, false, true, MSHV_TRANSLATE_PROTECTION, 0);
+
+    /* VM86 accesses use user-mode page permissions. */
+    map_long(0x123, 4, 0xa003);
+    env.eflags |= VM_MASK;
+    expect(0x123, false, false, MSHV_TRANSLATE_PROTECTION, 0);
+
+    /* Supervisor-page data access with PKS requires PKRS state. */
+    map_long(0x123, 4, 0xa003);
+    env.cr[4] |= CR4_PKS_MASK;
+    expect(0x123, false, false, MSHV_TRANSLATE_UNSUPPORTED, 0);
+
+    /* PKS does not apply to instruction fetches. */
+    expect(0x123, false, true, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* PKE does not apply to supervisor pages. */
+    env.cr[4] &= ~CR4_PKS_MASK;
+    env.cr[4] |= CR4_PKE_MASK;
+    expect(0x123, false, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* PKS does not apply to user pages. */
+    map_long(0x123, 4, 0xa007);
+    env.cr[4] |= CR4_PKS_MASK;
+    expect(0x123, false, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* PKE does not apply to instruction fetches. */
+    env.cr[4] &= ~CR4_PKS_MASK;
+    env.cr[4] |= CR4_PKE_MASK;
+    expect(0x123, false, true, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* SMEP does not block supervisor data access. */
+    map_long(0x123, 4, 0xa007);
+    env.cr[4] |= CR4_SMEP_MASK;
+    expect(0x123, false, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* SMAP does not block supervisor instruction fetches. */
+    env.cr[4] &= ~CR4_SMEP_MASK;
+    env.cr[4] |= CR4_SMAP_MASK;
+    expect(0x123, false, true, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* SMAP does not block user-mode data access. */
+    env.segs[R_CS].selector = 3;
+    expect(0x123, false, false, MSHV_TRANSLATE_OK, 0xa123);
+}
+
+/* Exercise user and supervisor LAM in four- and five-level paging. */
+static void test_lam(void)
+{
+    uint64_t tagged;
+
+    /* LAM_U48 strips tags from user data reads. */
+    map_long(0x123, 4, 0xa007);
+    env.cr[3] |= CR3_LAM_U48_MASK;
+    env.segs[R_CS].selector = 3;
+    tagged = 0x1234000000000123;
+    expect(tagged, false, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* LAM_U48 strips tags from user data writes. */
+    expect(tagged, true, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* LAM is not applied to instruction fetches. */
+    expect(tagged, false, true, MSHV_TRANSLATE_INVALID, 0);
+
+    /* LAM_U57 strips tags under five-level paging. */
+    map_long(0x123, 5, 0xa007);
+    env.cr[3] |= CR3_LAM_U57_MASK;
+    env.segs[R_CS].selector = 3;
+    tagged = (0x15ULL << 57) | 0x123;
+    expect(tagged, false, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* Supervisor LAM strips 48-bit-mode tags from high addresses. */
+    map_long(0xffff800000000123ULL, 4, 0xa007);
+    env.cr[4] |= CR4_LAM_SUP_MASK;
+    tagged = 0x9234800000000123ULL;
+    expect(tagged, false, false, MSHV_TRANSLATE_OK, 0xa123);
+
+    /* Supervisor LAM strips 57-bit-mode tags from high addresses. */
+    map_long(0xff00000000000123ULL, 5, 0xa007);
+    env.cr[4] |= CR4_LAM_SUP_MASK;
+    tagged = 0xab00000000000123ULL;
+    expect(tagged, false, false, MSHV_TRANSLATE_OK, 0xa123);
+}
+
+/* Exercise legacy PAE PDPTE reserved-bit and permission semantics. */
+static void test_legacy_pae(void)
+{
+    /* Legacy PAE reserves the PDPTE NX bit even when NXE is enabled. */
+    reset();
+    env.cr[4] = CR4_PAE_MASK;
+    env.efer = MSR_EFER_NXE;
+    entry64(0x1000, 0x2001 | PG_NX_MASK);
+    expect(0x123, false, false, MSHV_TRANSLATE_INVALID, 0);
+
+    /* Legacy PAE ignores RW and USER permission bits in PDPTEs. */
+    reset();
+    env.cr[4] = CR4_PAE_MASK;
+    entry64(0x1000, 0x2001);
+    entry64(0x2000, 0x3007);
+    entry64(0x3000, 0xa007);
+    env.segs[R_CS].selector = 3;
+    expect(0x123, true, false, MSHV_TRANSLATE_OK, 0xa123);
+}
+
+/* Exercise walk failures, page boundaries, and invalid addresses. */
+static void test_faults_and_boundaries(void)
+{
+    static const uint64_t walk_addresses[] = {
+        0x1000, 0x2000, 0x3000, 0x4000,
+    };
+    unsigned int i;
+
+    /* The final byte of a page uses the original mapping. */
+    map_long(0xfff, 4, 0xa007);
+    entry64(0x4008, 0xc007);
+    expect(0xfff, false, false, MSHV_TRANSLATE_OK, 0xafff);
+
+    /* The first byte of the next page uses the adjacent mapping. */
+    expect(0x1000, true, false, MSHV_TRANSLATE_OK, 0xc000);
+
+    /* Returning to the first page does not retain stale walk state. */
+    expect(0, true, false, MSHV_TRANSLATE_OK, 0xa000);
+
+    /* A missing adjacent PTE reports a not-present translation. */
+    entry64(0x4008, 0);
+    expect(0x1000, false, false, MSHV_TRANSLATE_NOT_PRESENT, 0);
+
+    /* An unreadable root table reports a memory error. */
+    unreadable = 0x1000;
+    expect(0, false, false, MSHV_TRANSLATE_MEMORY_ERROR, 0);
+
+    /* An unreadable entry at any walk level reports a memory error. */
+    for (i = 0; i < ARRAY_SIZE(walk_addresses); i++) {
+        map_long(0, 4, 0xa007);
+        unreadable = walk_addresses[i];
+        expect(0, false, false, MSHV_TRANSLATE_MEMORY_ERROR, 0);
+    }
+
+    /* Non-long modes reject virtual addresses above 32 bits. */
+    reset();
+    expect(UINT64_C(1) << 32, false, false, MSHV_TRANSLATE_INVALID, 0);
+
+    /* Long mode without PAE is an invalid paging configuration. */
+    reset();
+    env.cr[4] = 0;
+    env.efer = MSR_EFER_LMA;
+    expect(0, false, false, MSHV_TRANSLATE_INVALID, 0);
+
+    /* The upper boundary of the 48-bit low canonical half is valid. */
+    map_long(0x00007fffffffffffULL, 4, 0xa007);
+    expect(0x00007fffffffffffULL, false, false,
+           MSHV_TRANSLATE_OK, 0xafff);
+
+    /* The address immediately above the low canonical half is invalid. */
+    expect(0x0000800000000000ULL, false, false,
+           MSHV_TRANSLATE_INVALID, 0);
+
+    /* The lower boundary of the 48-bit high canonical half is valid. */
+    map_long(0xffff800000000000ULL, 4, 0xa007);
+    expect(0xffff800000000000ULL, false, false,
+           MSHV_TRANSLATE_OK, 0xa000);
+
+    /* The address immediately below the high canonical half is invalid. */
+    expect(0xffff7fffffffffffULL, false, false,
+           MSHV_TRANSLATE_INVALID, 0);
+
+    /* PSE-36 is unsupported */
+    reset();
+    env.cr[4] = CR4_PSE_MASK;
+    stl_le_p(ram + 0x1000, 0x802087);
+    expect(0x12345, false, false, MSHV_TRANSLATE_UNSUPPORTED, 0);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/mshv/mmu/modes", test_modes);
+    g_test_add_func("/mshv/mmu/large-pages", test_large_pages);
+    g_test_add_func("/mshv/mmu/permissions", test_permissions);
+    g_test_add_func("/mshv/mmu/lam", test_lam);
+    g_test_add_func("/mshv/mmu/legacy-pae", test_legacy_pae);
+    g_test_add_func("/mshv/mmu/faults-and-boundaries",
+                    test_faults_and_boundaries);
+    return g_test_run();
+}
