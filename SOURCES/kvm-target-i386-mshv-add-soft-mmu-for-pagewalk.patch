diff --git a/target/i386/mshv/mshv-mmu.c b/target/i386/mshv/mshv-mmu.c
new file mode 100644
index 0000000000..bce909abe3
--- /dev/null
+++ b/target/i386/mshv/mshv-mmu.c
@@ -0,0 +1,200 @@
+/*
+ * Copyright Microsoft, Corp. 2026
+ *
+ * Adapted for the qemu-kvm MSHV backend from the qemu upstream x86_mmu.c
+ * walker and from commits 1c85a4a3d7 and cb02fc2284 to replace
+ * HVCALL_TRANSLATE_VIRTUAL_ADDRESS in MMIO emulation with a software walk.
+ *
+ * Authors: Magnus Kulke  <magnuskulke@microsoft.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "mshv-mmu.h"
+
+#define CR3_LAM_U57_MASK (1ULL << 61)
+#define CR3_LAM_U48_MASK (1ULL << 62)
+
+#define LEGACY_PSE36_ADDRESS_MASK 0x1fe000ULL
+#define LEGACY_PSE_RESERVED_MASK  0x200000ULL
+
+/* strip the LAM tag from a non-canonical GVA */
+static void lam_untag(const CPUX86State *env, uint64_t *gva)
+{
+    size_t bit;
+
+    if (*gva & (1ULL << 63)) {
+        if (!(env->cr[4] & CR4_LAM_SUP_MASK)) {
+            return;
+        }
+        bit = (env->cr[4] & CR4_LA57_MASK) ? 56 : 47;
+    } else {
+        if (env->cr[3] & CR3_LAM_U57_MASK) {
+            bit = 56;
+        } else if (env->cr[3] & CR3_LAM_U48_MASK) {
+            bit = 47;
+        } else {
+            return;
+        }
+    }
+
+    *gva = (*gva & (1ULL << 63)) |
+           ((uint64_t)sextract64(*gva, 0, bit + 1) & ~(1ULL << 63));
+}
+
+MshvTranslateResult mshv_mmu_translate(const CPUX86State *env, uint64_t gva,
+                                       uint64_t *gpa, bool write, bool execute)
+{
+    uint64_t table, pte, address_mask;
+    uint32_t top, level, shift, index, entry_size;
+    bool user = (env->segs[R_CS].selector & 3) == 3 || (env->eflags & VM_MASK);
+    bool writable = true, user_page = true, executable = true;
+    size_t address_bits = env->cr[4] & CR4_LA57_MASK ? 57 : 48;
+    uint64_t offset_mask, base;
+    bool long_mode, pae, pdpte, large, pke, pks, wp, smep, smap, ac;
+    MemTxResult mem_tx_result;
+
+    long_mode = env->efer  & MSR_EFER_LMA;
+    if (!long_mode && gva > UINT32_MAX) {
+        return MSHV_TRANSLATE_INVALID;
+    }
+
+    /* paging off, real or protected mode w/o paging. A20 mask is not applied */
+    if (!(env->cr[0] & CR0_PG_MASK)) {
+        *gpa = gva;
+        return MSHV_TRANSLATE_OK;
+    }
+
+    pae = env->cr[4] & CR4_PAE_MASK;
+    if (long_mode) {
+        if (!pae) {
+            return MSHV_TRANSLATE_INVALID;
+        }
+
+        /* canonicalize the GVA for table walk */
+        if (!execute) {
+            lam_untag(env, &gva);
+        }
+        if (sextract64(gva, 0, address_bits) != (int64_t)gva) {
+            return MSHV_TRANSLATE_INVALID;
+        }
+        top = address_bits == 57 ? 5 : 4;
+        table = env->cr[3] & PG_ADDRESS_MASK;
+    } else {
+        top = pae ? 3 : 2;
+        table = env->cr[3] & (pae ? 0xffffffe0ULL : 0xfffff000ULL);
+    }
+    entry_size = pae ? 8 : 4;
+    address_mask = pae ? PG_ADDRESS_MASK : 0xfffff000ULL;
+
+    for (level = top; level; level--) {
+        shift = 12 + (pae ? 9 : 10) * (level - 1);
+        index = (gva >> shift) & (pae ? 0x1ff : 0x3ff);
+        if (pae && !long_mode && level == 3) {
+            index &= 3;
+        }
+
+        pte = entry_size == 8
+            ? address_space_ldq_le(&address_space_memory,
+                                   table + index * entry_size,
+                                   MEMTXATTRS_UNSPECIFIED, &mem_tx_result)
+            : address_space_ldl_le(&address_space_memory,
+                                   table + index * entry_size,
+                                   MEMTXATTRS_UNSPECIFIED, &mem_tx_result);
+        if (mem_tx_result != MEMTX_OK) {
+            return MSHV_TRANSLATE_MEMORY_ERROR;
+        }
+
+        if (!(pte & PG_PRESENT_MASK)) {
+            return MSHV_TRANSLATE_NOT_PRESENT;
+        }
+
+        if (pae && !(env->efer & MSR_EFER_NXE) && (pte & PG_NX_MASK)) {
+            return MSHV_TRANSLATE_INVALID;
+        }
+
+        /* legacy PAE PDPTE */
+        pdpte = pae && !long_mode && level == 3;
+        if (pdpte) {
+            /* legacy PAE PDPTEs carry no permission, bit 63 is reserved */
+            if (pte & PG_NX_MASK) {
+                return MSHV_TRANSLATE_INVALID;
+            }
+        } else {
+            writable   &= (pte & PG_RW_MASK)   != 0;
+            user_page  &= (pte & PG_USER_MASK) != 0;
+            executable &= !(pae && (pte & PG_NX_MASK));
+        }
+
+        large = level > 1 && (pte & PG_PSE_MASK) &&
+                (pae || (env->cr[4] & CR4_PSE_MASK));
+        if (large && (level > 3 || (level == 3 && !long_mode))) {
+            return MSHV_TRANSLATE_INVALID;
+        }
+
+        if (level == 1 || large) {
+            offset_mask = (1ULL << shift) - 1;
+
+            if (user && !user_page) {
+                return MSHV_TRANSLATE_PROTECTION;
+            }
+
+            wp = (env->cr[0] & CR0_WP_MASK);
+            if (write && !writable && (user || wp)) {
+                return MSHV_TRANSLATE_PROTECTION;
+            }
+
+            if (execute && !executable) {
+                return MSHV_TRANSLATE_PROTECTION;
+            }
+
+            smep = (env->cr[4] & CR4_SMEP_MASK);
+            smap = (env->cr[4] & CR4_SMAP_MASK);
+            ac = (env->eflags & AC_MASK);
+            if (!user
+                && user_page
+                && ((execute && smep) || (!execute && smap && !ac))) {
+                return MSHV_TRANSLATE_PROTECTION;
+            }
+
+            /* we don't roundtrip env->pkru and and env->pkrs */
+            pke = (env->cr[4] & CR4_PKE_MASK);
+            pks = (env->cr[4] & CR4_PKS_MASK);
+            if (!execute
+                && long_mode
+                && ((user_page && pke) || (!user_page && pks))) {
+                return MSHV_TRANSLATE_UNSUPPORTED;
+            }
+
+            if (large && !pae) {
+                if (pte & LEGACY_PSE_RESERVED_MASK) {
+                    return MSHV_TRANSLATE_INVALID;
+                }
+
+                /* PSE-36 is not supported */
+                if (pte & LEGACY_PSE36_ADDRESS_MASK) {
+                    return MSHV_TRANSLATE_UNSUPPORTED;
+                }
+
+                base = pte & 0xffc00000;
+            } else {
+                /* Bit 12 is PAT in large-page entries, not an address bit. */
+                if (large && (pte & address_mask & offset_mask & ~0x1000ULL)) {
+                    return MSHV_TRANSLATE_INVALID;
+                }
+                base = pte & address_mask & ~offset_mask;
+            }
+            *gpa = base | (gva & offset_mask);
+
+            return MSHV_TRANSLATE_OK;
+        }
+
+        table = pte & address_mask;
+    }
+
+    g_assert_not_reached();
+}
diff --git a/target/i386/mshv/mshv-mmu.h b/target/i386/mshv/mshv-mmu.h
new file mode 100644
index 0000000000..1205161dc4
--- /dev/null
+++ b/target/i386/mshv/mshv-mmu.h
@@ -0,0 +1,23 @@
+/*
+ * MSHV software page-table translation for local diagnostics.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef MSHV_MMU_H
+#define MSHV_MMU_H
+
+#include "cpu.h"
+
+typedef enum MshvTranslateResult {
+    MSHV_TRANSLATE_OK,
+    MSHV_TRANSLATE_NOT_PRESENT,
+    MSHV_TRANSLATE_PROTECTION,
+    MSHV_TRANSLATE_INVALID,
+    MSHV_TRANSLATE_MEMORY_ERROR,
+    MSHV_TRANSLATE_UNSUPPORTED,
+} MshvTranslateResult;
+
+MshvTranslateResult mshv_mmu_translate(const CPUX86State *env, uint64_t gva,
+                                       uint64_t *gpa, bool write, bool execute);
+
+#endif
