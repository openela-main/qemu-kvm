From f9f22a7e2a61f9b22c826c268e726e55ba57ffc0 Mon Sep 17 00:00:00 2001
From: Magnus Kulke <magnuskulke@linux.microsoft.com>
Date: Mon, 28 Sep 2026 17:12:20 +0200
Subject: [PATCH 1/2] target/i386/mshv: switch mmio pagewalk to mshv-mmu

RH-Author: Paolo Bonzini <pbonzini@redhat.com>
RH-MergeRequest: 581: target/i386/mshv: add soft-mmu for pagewalk
RH-Jira: RHEL-283119
RH-Acked-by: Richard W.M. Jones <rjones@redhat.com>
RH-Acked-by: Maxim Levitsky <None>
RH-Commit: [1/2] 7de1d5e71be0b7d623ab6cc5a43e63580c765f95

This change implements the switch from the hvcall that is used to
perform gva => gpa translation during MMIO emulation to calls to the
mshv-mmu userland implementation.

Downstream only patch, corresponding to upstream 9bc6a1d29605a13c541629a651e41787af65a963.

Signed-off-by: Magnus Kulke <magnuskulke@linux.microsoft.com>
---
 target/i386/mshv/mshv-cpu.c | 178 +++++++++++++-----------------------
 1 file changed, 64 insertions(+), 114 deletions(-)

diff --git a/target/i386/mshv/mshv-cpu.c b/target/i386/mshv/mshv-cpu.c
index c577e284b4..4e88834a00 100644
--- a/target/i386/mshv/mshv-cpu.c
+++ b/target/i386/mshv/mshv-cpu.c
@@ -28,6 +28,7 @@
 #include "emulate/x86_decode.h"
 #include "emulate/x86_emu.h"
 #include "emulate/x86_flags.h"
+#include "mshv-mmu.h"
 
 #include "trace-accel_mshv.h"
 #include "trace.h"
@@ -108,44 +109,33 @@ static enum hv_register_name FPU_REGISTER_NAMES[26] = {
     HV_X64_REGISTER_XMM_CONTROL_STATUS,
 };
 
-static int translate_gva(const CPUState *cpu, uint64_t gva, uint64_t *gpa,
-                         uint64_t flags)
-{
-    int ret;
-    int cpu_fd = mshv_vcpufd(cpu);
-    int vp_index = cpu->cpu_index;
-
-    hv_input_translate_virtual_address in = { 0 };
-    hv_output_translate_virtual_address out = { 0 };
-    struct mshv_root_hvcall args = {0};
-    uint64_t gva_page = gva >> HV_HYP_PAGE_SHIFT;
-
-    in.vp_index = vp_index;
-    in.control_flags = flags;
-    in.gva_page = gva_page;
-
-    /* create the hvcall envelope */
-    args.code = HVCALL_TRANSLATE_VIRTUAL_ADDRESS;
-    args.in_sz = sizeof(in);
-    args.in_ptr = (uint64_t) &in;
-    args.out_sz = sizeof(out);
-    args.out_ptr = (uint64_t) &out;
+static int guest_mem_write_with_gva(const CPUState *cpu, uint64_t gva,
+                                    const uint8_t *data, size_t len);
+static int guest_mem_read_with_gva(const CPUState *cpu, uint64_t gva,
+                                   uint8_t *data, size_t len, bool instruction);
 
-    /* perform the call */
-    ret = mshv_hvcall(cpu_fd, &args);
-    if (ret < 0) {
-        error_report("Failed to invoke gva->gpa translation");
-        return -errno;
-    }
+static int translate_gva(const CPUState *cpu, uint64_t gva, uint64_t *gpa,
+                         bool write, bool execute)
+{
+    const CPUX86State *env = &X86_CPU(cpu)->env;
+    MshvTranslateResult result;
+    const char * const errors[] = {
+        [MSHV_TRANSLATE_OK]           = "success",
+        [MSHV_TRANSLATE_NOT_PRESENT]  = "page not present",
+        [MSHV_TRANSLATE_PROTECTION]   = "permission denied",
+        [MSHV_TRANSLATE_INVALID]      = "invalid address or page-table entry",
+        [MSHV_TRANSLATE_MEMORY_ERROR] = "page-table read failed",
+        [MSHV_TRANSLATE_UNSUPPORTED]  = "protection keys unsupported",
+    };
 
-    if (out.translation_result.result_code != HV_TRANSLATE_GVA_SUCCESS) {
-        error_report("Failed to translate gva (" TARGET_FMT_lx ") to gpa", gva);
+    result = mshv_mmu_translate(env, gva, gpa, write, execute);
+    if (result != MSHV_TRANSLATE_OK) {
+        error_report("Software GVA => GPA translation failed: gva=0x%" PRIx64
+                     " cr3=0x%" PRIx64 "(%s)", gva, (uint64_t)env->cr[3],
+                     errors[result]);
         return -1;
     }
 
-    *gpa = ((out.gpa_page << HV_HYP_PAGE_SHIFT)
-         | (gva & ~(uint64_t)HV_HYP_PAGE_MASK));
-
     return 0;
 }
 
@@ -1311,58 +1301,6 @@ static int fetch_guest_state(CPUState *cpu)
     return 0;
 }
 
-static int read_memory(const CPUState *cpu, uint64_t initial_gva,
-                       uint64_t initial_gpa, uint64_t gva, uint8_t *data,
-                       size_t len)
-{
-    int ret;
-    uint64_t gpa, flags;
-
-    if (gva == initial_gva) {
-        gpa = initial_gpa;
-    } else {
-        flags = HV_TRANSLATE_GVA_VALIDATE_READ;
-        ret = translate_gva(cpu, gva, &gpa, flags);
-        if (ret < 0) {
-            return -1;
-        }
-
-        ret = mshv_guest_mem_read(gpa, data, len, false, false);
-        if (ret < 0) {
-            error_report("failed to read guest mem");
-            return -1;
-        }
-    }
-
-    return 0;
-}
-
-static int write_memory(const CPUState *cpu, uint64_t initial_gva,
-                        uint64_t initial_gpa, uint64_t gva, const uint8_t *data,
-                        size_t len)
-{
-    int ret;
-    uint64_t gpa, flags;
-
-    if (gva == initial_gva) {
-        gpa = initial_gpa;
-    } else {
-        flags = HV_TRANSLATE_GVA_VALIDATE_WRITE;
-        ret = translate_gva(cpu, gva, &gpa, flags);
-        if (ret < 0) {
-            error_report("failed to translate gva to gpa");
-            return -1;
-        }
-    }
-    ret = mshv_guest_mem_write(gpa, data, len, false);
-    if (ret != MEMTX_OK) {
-        error_report("failed to write to mmio");
-        return -1;
-    }
-
-    return 0;
-}
-
 static int handle_pio_str_write(CPUState *cpu,
                                 hv_x64_io_port_intercept_message *info,
                                 size_t repeat, uint16_t port,
@@ -1376,7 +1314,7 @@ static int handle_pio_str_write(CPUState *cpu,
     src = linear_addr(cpu, info->rsi, R_DS);
 
     for (size_t i = 0; i < repeat; i++) {
-        ret = read_memory(cpu, 0, 0, src, data, len);
+        ret = guest_mem_read_with_gva(cpu, src, data, len, false);
         if (ret < 0) {
             error_report("Failed to read memory");
             return -1;
@@ -1408,7 +1346,7 @@ static int handle_pio_str_read(CPUState *cpu,
     for (size_t i = 0; i < repeat; i++) {
         pio_read(port, data, len, false);
 
-        ret = write_memory(cpu, 0, 0, dst, data, len);
+        ret = guest_mem_write_with_gva(cpu, dst, data, len);
         if (ret < 0) {
             error_report("Failed to write memory");
             return -1;
@@ -1554,45 +1492,57 @@ int mshv_create_vcpu(int vm_fd, uint8_t vp_index, int *cpu_fd)
 }
 
 static int guest_mem_read_with_gva(const CPUState *cpu, uint64_t gva,
-                                   uint8_t *data, uintptr_t size,
-                                   bool fetch_instruction)
+                                   uint8_t *data, size_t len, bool instruction)
 {
-    int ret;
-    uint64_t gpa, flags;
+    size_t chunk;
+    uint64_t gpa;
+    size_t remaining = len;
 
-    flags = HV_TRANSLATE_GVA_VALIDATE_READ;
-    ret = translate_gva(cpu, gva, &gpa, flags);
-    if (ret < 0) {
-        error_report("failed to translate gva to gpa");
-        return -1;
-    }
+    while (remaining) {
+        chunk = MIN(remaining, 0x1000 - (gva & 0xfff));
 
-    ret = mshv_guest_mem_read(gpa, data, size, false, fetch_instruction);
-    if (ret < 0) {
-        error_report("failed to read from guest memory");
-        return -1;
+        if (translate_gva(cpu, gva, &gpa, false, instruction) < 0) {
+            return -1;
+        }
+
+        if (mshv_guest_mem_read(gpa, data, chunk, false, instruction) < 0) {
+            error_report("failed to read guest memory");
+            return -1;
+        }
+
+        gva       += chunk;
+        data      += chunk;
+        remaining -= chunk;
     }
 
     return 0;
 }
 
+
 static int guest_mem_write_with_gva(const CPUState *cpu, uint64_t gva,
-                                    const uint8_t *data, uintptr_t size)
+                                    const uint8_t *data, size_t len)
 {
-    int ret;
-    uint64_t gpa, flags;
+    size_t chunk;
+    uint64_t gpa;
+    size_t remaining = len;
 
-    flags = HV_TRANSLATE_GVA_VALIDATE_WRITE;
-    ret = translate_gva(cpu, gva, &gpa, flags);
-    if (ret < 0) {
-        error_report("failed to translate gva to gpa");
-        return -1;
-    }
-    ret = mshv_guest_mem_write(gpa, data, size, false);
-    if (ret < 0) {
-        error_report("failed to write to guest memory");
-        return -1;
+    while (remaining) {
+        chunk = MIN(remaining, 0x1000 - (gva & 0xfff));
+
+        if (translate_gva(cpu, gva, &gpa, true, false) < 0) {
+            return -1;
+        }
+
+        if (mshv_guest_mem_write(gpa, data, chunk, false) != MEMTX_OK) {
+            error_report("failed to write guest memory");
+            return -1;
+        }
+
+        gva       += chunk;
+        data      += chunk;
+        remaining -= chunk;
     }
+
     return 0;
 }
 
-- 
2.56.0

